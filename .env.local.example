# Neon (Postgres)
DATABASE_URL=

# Clerk (Google sign-in only)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Single-admin allowlist — only this Google account gets /admin access
ADMIN_EMAIL=

# Figma personal access token (Settings > Security > Personal access tokens,
# "File content: Read-only" scope) — used to pull real screen layouts via the
# Figma REST API, no Dev Mode seat required. See docs/FIGMA_MAPPING.md.
FIGMA_TOKEN=
FIGMA_FILE_KEY=

# Cloudinary (admin product media upload — image + video). Cloud name is safe
# client-side (an identifier, not a credential, per Cloudinary's own
# convention); API secret is server-only, used only to sign upload requests
# (src/lib/cloudinary.ts) — never sent to the browser. See docs/ADMIN.md.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
